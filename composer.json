{
    "name": "marble/entity-manager-bundle",
    "description": "Symfony bundle for Marble Entity Manager",
    "type": "symfony-bundle",
    "license": "MIT",
    "homepage": "https://github.com/marble-php/entity-manager-bundle",
    "authors": [
        {
            "name": "Mark van den Berg",
            "email": "mjpvandenberg@gmail.com"
        }
    ],
    "keywords": [
        "entity manager",
        "unit of work",
        "repository",
        "persistence",
        "bundle"
    ],
    "require": {
        "php": "^8.2.27",
        "marble/entity-manager": "~0.13",
        "phpdocumentor/reflection-docblock": "^6.0",
        "symfony/config": "^7.4|^8.0",
        "symfony/dependency-injection": "^7.4|^8.0",
        "symfony/expression-language": "^7.4|^8.0",
        "symfony/http-kernel": "^7.4|^8.0",
        "symfony/yaml": "^7.4|^8.0",
        "webmozart/assert": "^2"
    },
    "require-dev": {
        "dg/bypass-finals": "^1.9",
        "mockery/mockery": "^1.6.12",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^10|^11|^12|^13"
    },
    "autoload": {
        "psr-4": {
            "Marble\\EntityManager\\Bundle\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Marble\\EntityManager\\Bundle\\Tests\\": "tests"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        },
        "sort-packages": true
    }
}
